# Copy to .env. The renderer reads this file; real environment variables take precedence.
FAL_API_KEY=            # https://fal.ai/dashboard/keys  (video clips, MiniMax H3-Max)
FISH_AI_API_KEY=        # https://fish.audio/app/developers  (JJK narrator voice; API credit is separate from platform credit)
# OPENAI_API_KEY=       # optional fallback narrator voice (gpt-4o-mini-tts)
# EXPLAIN_MUSIC=        # optional: path to a music bed; default is the first audio file in ./assets/
# EXPLAIN_JP_FONT=Noto Serif CJK JP   # Linux: font with kanji glyphs for title cards (macOS default: Hiragino Mincho ProN)
# EXPLAIN_EN_FONT=DejaVu Sans
# IROH_FISH_VOICE_ID=   # optional: fish.audio voice for "style": "iroh" scripts (default 2356d9b259824b9f8b0aafb362f7c7f8); music for that style: first audio file in ./assets/iroh/

# video model + resolution defaults (renderer): h3-max-turbo|h3-max, 480P|768P
# EXPLAIN_MODEL=h3-max-turbo
# EXPLAIN_RESOLUTION=480P
